{
    "name": "facturino/facturino-php",
    "description": "Facturino PHP SDK — French e-invoicing API client",
    "type": "library",
    "license": "MIT",
    "keywords": ["facturino", "invoicing", "e-invoicing", "factur-x", "api", "france"],
    "homepage": "https://facturino.com",
    "authors": [
        {
            "name": "Facturino",
            "email": "dev@facturino.com",
            "homepage": "https://facturino.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Facturino\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Facturino\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
